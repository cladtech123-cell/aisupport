# Local development configuration.
# Create your local .env file with restricted permissions:
#   cp .env.example .env && chmod 600 .env
#
# In Railway, this file is NOT used. Configure the same variable names
# in your Railway service Variables tab instead.

# Telegram bot token from @BotFather (format: 123456789:ABC...).
# Remember to enable Business Mode in @BotFather -> Bot Settings -> Business Mode.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (get it from @userinfobot).
OWNER_ID=

# Whether to automatically send replies to Telegram Business chats.
# Keep false to only preview generated replies in the logs and data/previews.jsonl.
# Allowed values: true, false, 1, 0, yes, no, on, off.
AUTO_SEND=false

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Treat it like a password. Paste it on a SINGLE line using a text editor
# (do NOT use echo ... >> .env so it does not stay in shell history).
GEMINI_API_KEY=

# Gemini model name used to generate replies.
# Default is gemini-3.6-flash (fast and available on the Google AI Studio free tier).
GEMINI_MODEL=gemini-3.6-flash

# Maximum seconds to wait for a single Gemini API response (minimum: 1).
GEMINI_TIMEOUT_SECONDS=60

# Cooldown minutes when Gemini API quota/rate limit is hit without a retry timestamp (minimum: 1).
LIMIT_COOLDOWN_MINUTES=30

# Minutes to stay silent in a chat after you (the owner) send a message yourself (minimum: 0, 0 disables).
OWNER_TAKEOVER_MINUTES=15

# Maximum number of recent messages kept per business chat (minimum: 1).
HISTORY_LIMIT=30
